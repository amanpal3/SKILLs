# ============================================================
# .gitignore — Enterprise Security & Artifact Exclusions
# ============================================================

# --- 1. Environment Variables & Secrets ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- 2. Private Keys, Certificates & Credentials ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.token

# --- 3. Cloud & Service Auth Files ---
auth.json
oauth_creds.json
google_accounts.json
secrets.json
credentials.json
service-account*.json
client_secret*.json
skill_paths.txt

# --- 4. Local AI & Sandbox Runtime Data ---
.codex/
.sandbox/
.gemini/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# --- 5. Logs & Temporary Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.old
*~
*.swp
*.swo

# --- 6. Python Virtual Environments & Cache ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# --- 7. Node / Frontend Dependencies & Build ---
node_modules/
dist/
build/
.next/
out/
.turbo/

# --- 8. OS & IDE Metadata ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
